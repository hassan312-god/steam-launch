{
  "name": "steam-launch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "desktop:dev": "GA_URL=http://localhost:5173 electron .",
    "desktop:build": "electron-builder --publish never"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "hls.js": "^1.7.4",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "main": "desktop/main.cjs",
  "description": "G.A Launcher : launcher de jeux Steam (web + application de bureau)",
  "author": "G.A",
  "build": {
    "appId": "com.ga.launcher",
    "productName": "G.A Launcher",
    "artifactName": "GA-Launcher-Setup.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "desktop"
    },
    "files": [
      "desktop/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "icon": "desktop/icon.png",
      "artifactName": "GA-Launcher-mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "desktop/icon.png",
      "artifactName": "GA-Launcher-linux.${ext}"
    }
  }
}
